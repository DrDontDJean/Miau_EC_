# Copia de referencia. El archivo real (.env) lo rellena scripts/wizard-configuracion.sh.
# Nunca subas .env al repositorio ni lo incluyas en un paquete: .gitignore y
# scripts/empaquetar-entrega.mjs lo dejan fuera.
# El wizard guarda cada valor entre comillas simples: KEY='valor'. Al copiarlo a Vercel, sin comillas.

# Públicas (llegan al navegador). Van a Vercel como variables de tipo Config.
NEXT_PUBLIC_SUPABASE_URL=            # https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY= # sb_publishable_…

# Solo locales (ayudan a ubicarte; ningún workflow las usa).
SUPABASE_PROJECT_REF=                # las 20 letras de supabase.com/dashboard/project/<ref>
SUPABASE_DB_PASSWORD=                # contraseña de Postgres; ya va dentro de DATABASE_URL
GITHUB_REPO=                         # usuario/repositorio

# Secretas. También van como secretos de GitHub Actions (el wizard las carga con gh).
DATABASE_URL=                        # URI del Session pooler (puerto 5432) con la contraseña
VERCEL_AUTOMATION_BYPASS_SECRET=     # abre las vistas previas protegidas a k6
