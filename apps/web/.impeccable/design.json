  "components": [
    {
      "name": "Cabecera con buscador",
      "kind": "nav",
      "refersTo": "cabecera",
      "description": "Franja de hechos en acero fuerte, logotipo y buscador en píldora sobre acero, pestañas de categorías en mayúsculas.",
      "html": "<header class=\"ds-cab\"><p class=\"ds-cab-franja\">Precios leídos el 11 nov, 11:14 · Sin patrocinios</p><div class=\"ds-cab-fila\"><span class=\"ds-logo\">Decide<span>Aqui</span></span><form class=\"ds-busca\"><input placeholder=\"Buscar un producto\"><button type=\"button\">Buscar</button></form></div><nav class=\"ds-pest\"><a aria-current=\"page\">Televisores</a><a>Laptops</a></nav></header>",
      "css": ".ds-cab{font-family:var(--fuente,\"Hanken Grotesk\"),system-ui,sans-serif;background:var(--cabecera,#346a8f);color:#fff}.ds-cab-franja{margin:0;background:var(--cabecera-fuerte,#2a5675);color:var(--en-cabecera-suave,#dde7ee);font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:.05em;padding:8px 16px;text-align:center}.ds-cab-fila{display:flex;gap:24px;align-items:center;padding:12px 16px}.ds-logo{font-size:24px;font-weight:800;letter-spacing:-.025em}.ds-logo span{margin-left:2px;background:var(--cian,#13a9cf);color:var(--en-cian,#1f1f33);border-radius:6px;padding:0 6px}.ds-busca{display:flex;flex:1}.ds-busca input{flex:1;height:44px;border:0;border-radius:9999px 0 0 9999px;padding:0 16px;font:inherit;color:#36364f}.ds-busca button{height:44px;border:0;border-radius:0 9999px 9999px 0;padding:0 20px;background:var(--cian,#13a9cf);color:var(--en-cian,#1f1f33);font:inherit;font-weight:600;cursor:pointer}.ds-busca :focus-visible{outline:2px solid #fff;outline-offset:2px}.ds-pest{display:flex;justify-content:center}.ds-pest a{display:flex;align-items:center;height:44px;padding:0 12px;font-size:14px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--en-cabecera-suave,#dde7ee);border-bottom:3px solid transparent;cursor:pointer}.ds-pest a:hover{border-color:rgb(255 255 255/.4);color:#fff}.ds-pest a[aria-current]{color:#fff;border-color:#fff}"
    },
    {
      "name": "Botón Ver oferta",
      "kind": "button",
      "refersTo": "boton-oferta",
      "description": "Único botón sólido por decisión: recuadro de precio y fila más barata.",
      "html": "<button class=\"ds-btn\">Ver oferta</button>",
      "css": ".ds-btn{font-family:var(--fuente,\"Hanken Grotesk\"),system-ui,sans-serif;min-height:44px;padding:0 16px;border:1px solid var(--borde-accion,#346a8f);border-radius:8px;background:var(--accion,#346a8f);color:var(--en-accion,#fff);font-weight:600;font-size:16px;cursor:pointer;transition:background-color 150ms}.ds-btn:hover{background:var(--accion-fuerte,#2a5675)}.ds-btn:focus-visible{outline:2px solid var(--foco,#1f1f33);outline-offset:2px}"
    },
    {
      "name": "Botón de contorno",
      "kind": "button",
      "refersTo": "boton-contorno",
      "description": "Ofertas con stock que no son la más barata.",
      "html": "<button class=\"ds-btn-contorno\">Ver oferta</button>",
      "css": ".ds-btn-contorno{font-family:var(--fuente,\"Hanken Grotesk\"),system-ui,sans-serif;min-height:44px;padding:0 16px;border:1px solid var(--borde-accion,#346a8f);border-radius:8px;background:var(--superficie,#fff);color:var(--enlace,#346a8f);font-weight:600;font-size:16px;cursor:pointer;transition:background-color 150ms}.ds-btn-contorno:hover{background:var(--seccion,#e3e6eb)}.ds-btn-contorno:focus-visible{outline:2px solid var(--foco,#1f1f33);outline-offset:2px}"
    },
    {
      "name": "Botón secundario",
      "kind": "button",
      "refersTo": "boton-secundario",
      "description": "Ofertas sin stock (\"Ver en la tienda\") y salidas rápidas.",
      "html": "<button class=\"ds-btn-sec\">Ver en la tienda</button>",
      "css": ".ds-btn-sec{font-family:var(--fuente,\"Hanken Grotesk\"),system-ui,sans-serif;min-height:44px;padding:0 16px;border:1px solid var(--borde-control,#737a88);border-radius:8px;background:transparent;color:var(--texto,#36364f);font-weight:600;font-size:16px;cursor:pointer;transition:background-color 150ms}.ds-btn-sec:hover{background:var(--seccion,#e3e6eb)}.ds-btn-sec:focus-visible{outline:2px solid var(--foco,#1f1f33);outline-offset:2px}"
    },
    {
      "name": "Tarjeta de producto",
      "kind": "card",
      "refersTo": "tarjeta-producto",
      "description": "Imagen en pozo blanco, título, precio y una línea de meta; toda la tarjeta es enlace, sin botón.",
      "html": "<a class=\"ds-tarjeta\"><span class=\"ds-tarjeta-img\"></span><span class=\"ds-tarjeta-cuerpo\"><span class=\"ds-tarjeta-titulo\">Licuadora 1.5 litros con jarra de vidrio</span><span class=\"ds-tarjeta-precio\"><small>desde</small><strong>$34,08</strong></span><span class=\"ds-tarjeta-meta\">En 3 tiendas · más barato en Comandato</span></span></a>",
      "css": ".ds-tarjeta{font-family:var(--fuente,\"Hanken Grotesk\"),system-ui,sans-serif;display:flex;flex-direction:column;width:220px;border:1px solid var(--borde,#dde1e6);border-radius:8px;overflow:hidden;background:var(--superficie,#fff);color:var(--texto,#36364f);text-decoration:none;cursor:pointer;transition:border-color 150ms}.ds-tarjeta:hover{border-color:var(--borde-control,#737a88)}.ds-tarjeta:hover .ds-tarjeta-titulo{text-decoration:underline}.ds-tarjeta-img{display:block;aspect-ratio:1;background:#fff;border-bottom:1px solid var(--borde,#dde1e6)}.ds-tarjeta-cuerpo{display:flex;flex-direction:column;gap:8px;padding:12px}.ds-tarjeta-titulo{font-size:14px;font-weight:600;line-height:1.375}.ds-tarjeta-precio{display:flex;align-items:baseline;gap:4px}.ds-tarjeta-precio small{font-size:12px;color:var(--suave,#5f6070)}.ds-tarjeta-precio strong{font-size:20px;font-weight:800;font-variant-numeric:tabular-nums}.ds-tarjeta-meta{margin-top:-4px;font-size:12px;color:var(--suave,#5f6070)}"
    },
    {
      "name": "Fila de oferta más barata",
      "kind": "custom",
      "refersTo": "fila-oferta-barata",
      "description": "Borde cian, fondo resalte, marca \"Más barato\" junto al precio y botón sólido.",
      "html": "<div class=\"ds-fila\"><div><p class=\"ds-fila-tienda\">Comandato</p><p class=\"ds-fila-stock\">✓ En stock</p></div><div class=\"ds-fila-precio\"><p><span class=\"ds-marca\">Más barato</span><strong>$156,51</strong></p><p class=\"ds-fila-leido\">leído hoy 11:11</p></div></div>",
      "css": ".ds-fila{font-family:var(--fuente,\"Hanken Grotesk\"),system-ui,sans-serif;display:flex;justify-content:space-between;align-items:center;gap:16px;width:420px;padding:16px;border:2px solid var(--cian,#13a9cf);border-radius:8px;background:var(--resalte,#e7f6fa);color:var(--texto,#36364f)}.ds-fila p{margin:0}.ds-fila-tienda{font-size:18px;font-weight:700}.ds-fila-stock{font-size:14px;font-weight:600}.ds-fila-precio{text-align:right}.ds-fila-precio p:first-child{display:flex;align-items:baseline;gap:8px;justify-content:flex-end}.ds-fila-precio strong{font-size:30px;font-weight:800;font-variant-numeric:tabular-nums}.ds-marca{white-space:nowrap;border-radius:9999px;background:var(--cian,#13a9cf);color:var(--en-cian,#1f1f33);padding:2px 8px;font-size:12px;font-weight:600}.ds-fila-leido{font-size:12px;color:var(--suave,#5f6070)}"
    },
    {
      "name": "Recuadro de precio",
      "kind": "custom",
      "refersTo": "panel",
      "description": "Panel fijo de la ficha: etiqueta cian, precio grande, datos de la tienda y el único botón sólido.",
      "html": "<aside class=\"ds-recuadro\"><p class=\"ds-etiqueta\">Precio más bajo</p><p class=\"ds-recuadro-precio\">$156,51</p><dl><dt>Tienda</dt><dd>Comandato</dd><dt>Leído</dt><dd>hoy 11:11</dd></dl><a class=\"ds-recuadro-btn\">Ver oferta en Comandato</a></aside>",
      "css": ".ds-recuadro{font-family:var(--fuente,\"Hanken Grotesk\"),system-ui,sans-serif;width:300px;padding:24px;border-radius:16px;background:var(--superficie,#fff);color:var(--texto,#36364f)}.ds-recuadro p{margin:0}.ds-etiqueta{width:fit-content;border-radius:9999px;background:var(--cian,#13a9cf);color:var(--en-cian,#1f1f33);padding:2px 10px;font-size:14px;font-weight:600}.ds-recuadro-precio{margin-top:4px!important;font-size:48px;font-weight:800;line-height:1;font-variant-numeric:tabular-nums}.ds-recuadro dl{display:grid;grid-template-columns:auto 1fr;gap:4px 16px;margin:16px 0 0;font-size:14px}.ds-recuadro dt{color:var(--suave,#5f6070)}.ds-recuadro dd{margin:0;font-weight:600}.ds-recuadro-btn{display:flex;align-items:center;justify-content:center;min-height:48px;margin-top:20px;border-radius:8px;background:var(--accion,#346a8f);color:#fff;font-weight:700;cursor:pointer;transition:background-color 150ms}.ds-recuadro-btn:hover{background:var(--accion-fuerte,#2a5675)}"
    },
    {
      "name": "Chips de la ficha",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Píldoras grises con datos del producto, en mayúscula inicial normal.",
      "html": "<ul class=\"ds-chips\"><li>En 3 tiendas</li><li>Con stock</li></ul>",
      "css": ".ds-chips{font-family:var(--fuente,\"Hanken Grotesk\"),system-ui,sans-serif;display:flex;gap:8px;list-style:none;margin:0;padding:0}.ds-chips li{border-radius:9999px;background:var(--seccion,#e3e6eb);color:var(--texto,#36364f);padding:4px 12px;font-size:14px;font-weight:600}"
    },
    {
      "name": "Filtros de búsqueda",
      "kind": "custom",
      "refersTo": "",
      "description": "Orden activo con barra cian interior; casillas acero con conteo.",
      "html": "<div class=\"ds-filtros\"><p class=\"ds-filtros-h\">Ordenar por</p><a class=\"ds-orden\" aria-current=\"true\">Relevancia</a><a class=\"ds-orden\">Menor precio</a><p class=\"ds-filtros-h\">Mostrar</p><a class=\"ds-casilla\"><span class=\"ds-caja on\">✓</span>Con stock<em>18</em></a><a class=\"ds-casilla\"><span class=\"ds-caja\"></span>En varias tiendas<em>7</em></a></div>",
      "css": ".ds-filtros{font-family:var(--fuente,\"Hanken Grotesk\"),system-ui,sans-serif;display:flex;flex-direction:column;gap:4px;width:240px;color:var(--texto,#36364f)}.ds-filtros-h{margin:12px 0 4px;font-weight:700}.ds-orden,.ds-casilla{display:flex;align-items:center;gap:12px;min-height:44px;padding:0 12px;border-radius:8px;cursor:pointer}.ds-orden{font-weight:600;color:var(--suave,#5f6070)}.ds-orden:hover,.ds-casilla:hover{background:var(--superficie,#fff)}.ds-orden[aria-current]{background:var(--superficie,#fff);color:var(--texto,#36364f);box-shadow:inset 3px 0 0 var(--cian,#13a9cf)}.ds-caja{display:grid;place-items:center;width:20px;height:20px;border:2px solid var(--borde-control,#737a88);border-radius:4px;background:#fff;font-size:12px}.ds-caja.on{border-color:var(--accion,#346a8f);background:var(--accion,#346a8f);color:#fff}.ds-casilla em{margin-left:auto;font-style:normal;font-size:14px;color:var(--suave,#5f6070)}"
    }
  ],
  "narrative": {
    "northStar": "El precio con fecha",
    "overview": "DecideAqui se lee como un catálogo de tienda online, pero honesto: franja de hechos y cabecera en azul acero con buscador en píldora, paneles blancos sobre fondo gris claro y pie del mismo acero que la cabecera. La estructura es familiar a propósito.\n\nLo propio es la disciplina de funciones: el acero es la casa y la voz de actuar; el cian solo señala el precio (botón Buscar, \"Precio más bajo\", \"Más barato\", borde de la oferta más barata, punto \"hoy\"); el grafito lee y el gris separa. La portada persuade; búsqueda y ficha operan, densas y escaneables.\n\nEl registro es formal (usted), breve y sin explicaciones obvias.",
    "keyCharacteristics": [
      "Paneles blancos de 16 px sobre fondo gris; nada de sombras en reposo.",
      "Cabecera y pie en el mismo acero; franja superior en acero fuerte.",
      "Cian siempre con tinta profunda y solo para señalar precio.",
      "Un único botón sólido por decisión: el de la mejor oferta.",
      "Mayúsculas solo en la franja de hechos y en el menú de categorías.",
      "Peso 800 solo para h1 y precios.",
      "Horas en America/Guayaquil; objetivos táctiles de 44 px."
    ],
    "rules": [
      {
        "name": "The Tinta Profunda Rule",
        "body": "Todo lo que va sobre cian lleva --en-cian (#1F1F33), en ambos temas.",
        "section": "colors"
      },
      {
        "name": "The Cian Señala Rule",
        "body": "El cian marca precio y búsqueda; sobre el acero de la cabecera (2.11:1) los estados activos van en blanco.",
        "section": "colors"
      },
      {
        "name": "The Un Botón Sólido Rule",
        "body": "Un solo botón acero sólido por decisión; el resto en contorno acero, o gris si no hay stock.",
        "section": "colors"
      },
      {
        "name": "The Peso con Motivo Rule",
        "body": "El peso 800 es solo para h1 y precios; h2 en 700, etiquetas en 600.",
        "section": "typography"
      },
      {
        "name": "The Mayúsculas Contadas Rule",
        "body": "Mayúsculas forzadas solo en la franja de hechos y el menú de categorías.",
        "section": "typography"
      },
      {
        "name": "The Cifra Tabular Rule",
        "body": "Todo importe usa tabular-nums; en filas de oferta, alineado a la derecha.",
        "section": "typography"
      },
      {
        "name": "The Plano en Reposo Rule",
        "body": "Nada flota: panel, borde o fondo tonal. El hover de la tarjeta oscurece el borde y subraya el título.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do poner --en-cian sobre todo fondo cian.",
      "Do poner blanco sobre el acero y usar acero para la casa y para actuar.",
      "Do dejar un único botón sólido por decisión.",
      "Do escribir en registro formal (usted), breve y sin explicar lo obvio.",
      "Do mostrar \"leído …\" en hora de Guayaquil una vez por oferta en la ficha.",
      "Do expresar estado con icono, marca o trazo además del color.",
      "Do dar 44 px a todo lo que se pulsa y mantener visible el foco."
    ],
    "donts": [
      "Don't usar cian como indicador sobre el acero de la cabecera.",
      "Don't forzar mayúsculas fuera de la franja y del menú de categorías.",
      "Don't usar peso 800 en h2, etiquetas o botones.",
      "Don't repetir el aviso de confirmar el precio.",
      "Don't añadir botones, etiquetas sobre la imagen ni sombras a la tarjeta.",
      "Don't repetir en la página los hechos de la franja de la cabecera.",
      "Don't dibujar el historial con menos de 7 días.",
      "Don't introducir una segunda familia tipográfica."
    ]
  }
